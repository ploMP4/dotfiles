theme = TokyoNight Night
# Wallpaper-derived colors (generated by wallust). Optional (?) so ghostty
# falls back to the theme above before the first run. Overrides it once present.
font-family = ZedMono Nerd Font
font-size = 17

config-file = ?wallust
# font-family = JetBrainsMono Nerd Font
# font-size = 17
background-opacity = 0.82
gtk-custom-css = ~/.config/ghostty/blur.css
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
font-feature = -calt

window-decoration = true
gtk-titlebar = false
keybind = shift+enter=text:\x1b\r
