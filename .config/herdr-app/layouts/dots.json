      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              }
            }
          ],
          "size": {
            "px": 250
          },
          "min": 44,
          "max": 480,
          "hidden": true,
          "background": "chrome",
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 4,
          "divider": {
