                "content": "tabs"
              }
            }
          ],
          "size": {
            "px": 380
          },
          "min": 280,
          "max": 900,
          "hidden": true,
          "background": "chrome",
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 4
